# runtime state, never committed (docs/DATA_AND_MEMORY.md section 3)
.crabby/
probes/.deps/
probes/out/
node_modules/
dist/
data/
*.log
.DS_Store

# generated by the repo's own python scripts (`scripts/check-docs.py`, `count-inventory.py`), which are run
# from a dirty tree far more often than they are committed
__pycache__/
*.pyc
